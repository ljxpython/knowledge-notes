---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Prose from '../components/Prose.astro';
import ContentsRail from '../components/ContentsRail.astro';
import DocNav from '../components/DocNav.astro';
import ResourceLinks from '../components/ResourceLinks.astro';
import DocSidebar from '../components/DocSidebar.astro';
import { site, withBase } from '../lib/site';

interface Resource {
  label: string;
  url: string;
}

interface Props {
  id: string;
  collection: string;
  collectionTitle: string;
  collectionNotice?: string;
  collectionSourceLabel?: string;
  collectionSourceUrl?: string;
  title: string;
  description: string;
  section?: string;
  order: number;
  source?: string;
  resources: Resource[];
  headings: Array<{ depth: number; slug: string; text: string }>;
  words?: number;
  minutes?: number;
  prev: { collection: string; id: string; title: string; section?: string } | null;
  next: { collection: string; id: string; title: string; section?: string } | null;
}

const { id, collection, collectionTitle, collectionNotice, collectionSourceLabel, collectionSourceUrl, title, description, section, order, source, resources, headings, words, minutes, prev, next } = Astro.props;
const sourceUrl = source ?? collectionSourceUrl ?? `${site.repositoryUrl}/blob/main/content/${id}.md`;
const sourceLabel = collectionSourceLabel ?? site.navigation.sourceLabel;
---

<BaseLayout title={`${title} | ${site.title}`} description={description}>
  <div id="reading-progress" class="reading-progress" aria-hidden="true"></div>
  <Header showSidebarToggle={true} />
  
  <main class="doc-shell">
    <div id="sidebar-hover-zone" class="sidebar-hover-zone" aria-hidden="true"></div>
    <aside class="doc-sidebar-desktop" aria-label="全站知识总大纲">
      <div class="sidebar-sticky-wrapper">
        <DocSidebar currentDocId={id} currentCollection={collection} />
      </div>
    </aside>

    <div class="doc-body-container">
      <article class="doc" data-pagefind-body>
        <header class="doc-header">
          <div class="eyebrow">
            <span>{section ?? collectionTitle}</span>
            <span>第 {String(order).padStart(2, '0')} 篇</span>
          </div>
          <h1>{title}</h1>
          <p>{description}</p>
          {collectionNotice && <p class="notice">{collectionNotice}</p>}
          <div class="doc-meta">
            <div class="doc-meta-left">
              <a href={withBase('/')} class="quiet-link">全部笔记</a>
              <span class="meta-separator">·</span>
              <a href={sourceUrl} target="_blank" rel="noopener" class="quiet-link">{sourceLabel}</a>
            </div>
            {words && minutes && (
              <div class="doc-meta-stats">
                <span>约 {words} 字</span>
                <span class="meta-separator">·</span>
                <span>预计阅读 {minutes} 分钟</span>
              </div>
            )}
          </div>
        </header>

        <ContentsRail headings={headings} mode="mobile" />

        <Prose><slot /></Prose>
        <ResourceLinks resources={resources} />
        <DocNav prev={prev} next={next} />
      </article>
    </div>

    <aside class="doc-toc-desktop" aria-label="本页目录">
      <div class="toc-sticky-wrapper">
        <ContentsRail headings={headings} mode="desktop" />
      </div>
    </aside>
    <div id="toc-hover-zone" class="toc-hover-zone" aria-hidden="true"></div>
  </main>

  <dialog id="sidebar-drawer" class="sidebar-drawer" aria-label="全站章节目录抽屉">
    <div class="sidebar-drawer-inner">
      <div class="sidebar-drawer-header">
        <span class="drawer-title">全站知识目录</span>
        <button id="sidebar-drawer-close" class="drawer-close-btn" type="button" aria-label="关闭目录">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
      <div class="sidebar-drawer-body">
        <DocSidebar currentDocId={id} currentCollection={collection} isDrawer={true} />
      </div>
    </div>
  </dialog>

  <dialog id="image-lightbox" class="image-lightbox" aria-label="查看大图">
    <img id="lightbox-img" src="" alt="" />
  </dialog>

  <button id="back-to-top" class="back-to-top-btn" type="button" aria-label="返回顶部" title="返回顶部">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <line x1="12" y1="19" x2="12" y2="5"></line>
      <polyline points="5 12 12 5 19 12"></polyline>
    </svg>
  </button>

  <Footer />
</BaseLayout>

<script>
  // 1. 阅读进度条
  const progressBar = document.getElementById('reading-progress');
  function updateProgress() {
    if (!progressBar) return;
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
    const scrolled = docHeight > 0 ? (window.scrollY / docHeight) * 100 : 0;
    progressBar.style.width = `${Math.min(100, Math.max(0, scrolled))}%`;
  }
  window.addEventListener('scroll', updateProgress, { passive: true });
  updateProgress();

  // 2. 正文代码块增强：一键复制与语言角标
  document.querySelectorAll<HTMLPreElement>('.prose pre').forEach((pre) => {
    if (pre.closest('.code-block-wrapper')) return;

    const wrapper = document.createElement('div');
    wrapper.className = 'code-block-wrapper';
    pre.parentNode?.insertBefore(wrapper, pre);
    wrapper.appendChild(pre);

    const lang = pre.getAttribute('data-language');
    if (lang && lang !== 'plaintext') {
      const badge = document.createElement('span');
      badge.className = 'code-lang-badge';
      badge.textContent = lang.toUpperCase();
      wrapper.appendChild(badge);
    }

    const copyBtn = document.createElement('button');
    copyBtn.className = 'code-copy-btn';
    copyBtn.type = 'button';
    copyBtn.setAttribute('aria-label', '复制代码');
    copyBtn.innerHTML = `
      <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
      </svg>
      <span>复制</span>
    `;

    copyBtn.addEventListener('click', async () => {
      const code = pre.querySelector('code')?.innerText ?? pre.innerText;
      await navigator.clipboard.writeText(code);
      copyBtn.classList.add('copied');
      copyBtn.innerHTML = `
        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span>已复制</span>
      `;
      setTimeout(() => {
        copyBtn.classList.remove('copied');
        copyBtn.innerHTML = `
          <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <span>复制</span>
        `;
      }, 1500);
    });

    wrapper.appendChild(copyBtn);
  });

  // 3. 原生图片点击平滑放大 (Image Lightbox)
  const lightbox = document.getElementById('image-lightbox') as HTMLDialogElement | null;
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
  if (lightbox && lightboxImg) {
    document.querySelectorAll<HTMLImageElement>('.prose img').forEach((img) => {
      img.classList.add('zoomable-img');
      img.addEventListener('click', () => {
        lightboxImg.src = img.src;
        lightboxImg.alt = img.alt || '';
        lightbox.showModal();
        document.body.style.overflow = 'hidden';
      });
    });

    function closeLightbox() {
      if (!lightbox) return;
      lightbox.close();
      document.body.style.overflow = '';
    }

    lightbox.addEventListener('click', closeLightbox);
    lightbox.addEventListener('close', () => { document.body.style.overflow = ''; });
  }

  // 4. 返回顶部浮窗
  const backToTop = document.getElementById('back-to-top');
  window.addEventListener('scroll', () => {
    if (backToTop) {
      backToTop.classList.toggle('visible', window.scrollY > 400);
    }
  }, { passive: true });

  backToTop?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  // 5. 章节目录抽屉开关
  const sidebarToggle = document.getElementById('sidebar-toggle');
  const sidebarDrawer = document.getElementById('sidebar-drawer') as HTMLDialogElement | null;
  const sidebarDrawerClose = document.getElementById('sidebar-drawer-close');

  function openDrawer() {
    if (!sidebarDrawer) return;
    sidebarDrawer.showModal();
    document.body.style.overflow = 'hidden';
  }

  function closeDrawer() {
    if (!sidebarDrawer) return;
    sidebarDrawer.close();
    document.body.style.overflow = '';
  }

  function handleSidebarToggle() {
    if (window.innerWidth < 1280) {
      openDrawer();
    } else {
      const isCollapsed = document.documentElement.classList.toggle('sidebar-collapsed');
      document.documentElement.classList.remove('sidebar-peeking');
      localStorage.setItem('knowledge-site-sidebar-collapsed', isCollapsed ? 'true' : 'false');
    }
  }

  sidebarToggle?.addEventListener('click', handleSidebarToggle);
  sidebarDrawerClose?.addEventListener('click', closeDrawer);
  sidebarDrawer?.addEventListener('click', (e) => {
    if (e.target === sidebarDrawer) closeDrawer();
  });

  // 6. 交互逻辑：左侧特定位置悬浮自然显示 (Hover Peek)
  const hoverZone = document.getElementById('sidebar-hover-zone');
  const sidebarDesktop = document.querySelector('.doc-sidebar-desktop');
  let peekTimer: any = null;

  hoverZone?.addEventListener('mouseenter', () => {
    if (document.documentElement.classList.contains('sidebar-collapsed')) {
      clearTimeout(peekTimer);
      document.documentElement.classList.add('sidebar-peeking');
    }
  });

  hoverZone?.addEventListener('mouseleave', () => {
    if (document.documentElement.classList.contains('sidebar-peeking')) {
      clearTimeout(peekTimer);
      peekTimer = setTimeout(() => {
        if (!sidebarDesktop?.matches(':hover')) {
          document.documentElement.classList.remove('sidebar-peeking');
        }
      }, 300);
    }
  });

  sidebarDesktop?.addEventListener('mouseenter', () => {
    clearTimeout(peekTimer);
  });

  sidebarDesktop?.addEventListener('mouseleave', () => {
    if (document.documentElement.classList.contains('sidebar-peeking')) {
      clearTimeout(peekTimer);
      peekTimer = setTimeout(() => {
        if (!hoverZone?.matches(':hover')) {
          document.documentElement.classList.remove('sidebar-peeking');
        }
      }, 300);
    }
  });

  // 7. 交互逻辑：右侧特定位置悬浮自然显示 (TOC Hover Peek)
  const tocHoverZone = document.getElementById('toc-hover-zone');
  const tocDesktop = document.querySelector('.doc-toc-desktop');
  let tocPeekTimer: any = null;

  tocHoverZone?.addEventListener('mouseenter', () => {
    if (document.documentElement.classList.contains('toc-collapsed')) {
      clearTimeout(tocPeekTimer);
      document.documentElement.classList.add('toc-peeking');
    }
  });

  tocHoverZone?.addEventListener('mouseleave', () => {
    if (document.documentElement.classList.contains('toc-peeking')) {
      clearTimeout(tocPeekTimer);
      tocPeekTimer = setTimeout(() => {
        if (!tocDesktop?.matches(':hover')) {
          document.documentElement.classList.remove('toc-peeking');
        }
      }, 300);
    }
  });

  tocDesktop?.addEventListener('mouseenter', () => {
    clearTimeout(tocPeekTimer);
  });

  tocDesktop?.addEventListener('mouseleave', () => {
    if (document.documentElement.classList.contains('toc-peeking')) {
      clearTimeout(tocPeekTimer);
      tocPeekTimer = setTimeout(() => {
        if (!tocHoverZone?.matches(':hover')) {
          document.documentElement.classList.remove('toc-peeking');
        }
      }, 300);
    }
  });
</script>
