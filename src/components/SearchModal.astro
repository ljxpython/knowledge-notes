---
import { site, withBase } from '../lib/site';
const siteBase = site.base.replace(/\/$/, '');
---

<div class="search-wrapper">
  <button
    id="search-trigger"
    class="search-trigger-btn"
    type="button"
    aria-label="全站搜索"
    title="全站搜索 (⌘K 或 Ctrl+K)"
  >
    <svg class="search-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="8.5" cy="8.5" r="5.5" />
      <line x1="13" y1="13" x2="17.5" y2="17.5" />
    </svg>
    <span class="search-label">搜索</span>
    <kbd class="search-hotkey">⌘K</kbd>
  </button>

  <dialog id="search-modal" class="search-modal">
    <div class="search-dialog-inner">
      <div class="search-dialog-header">
        <span class="search-dialog-title">全站搜索</span>
        <button id="search-close" class="search-close-btn" type="button" aria-label="关闭搜索">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
      <div id="search-container" class="search-container">
        <p class="search-loading">正在载入全文搜索索引...</p>
      </div>
    </div>
  </dialog>
</div>

<script is:inline define:vars={{ siteBase }}>
  (() => {
    const trigger = document.getElementById('search-trigger');
    const modal = document.getElementById('search-modal');
    const closeBtn = document.getElementById('search-close');
    let pagefindLoaded = false;
    let pagefindInitializing = false;

    function loadPagefindAssets() {
      if (pagefindLoaded || pagefindInitializing) return;
      pagefindInitializing = true;

      // Inject Pagefind CSS
      const link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = `${siteBase}/pagefind/pagefind-ui.css`;
      document.head.appendChild(link);

      // Inject Pagefind Script
      const script = document.createElement('script');
      script.src = `${siteBase}/pagefind/pagefind-ui.js`;
      script.onload = () => {
        pagefindLoaded = true;
        pagefindInitializing = false;
        try {
          const container = document.getElementById('search-container');
          if (container) container.innerHTML = '';
          // @ts-ignore
          new PagefindUI({
            element: '#search-container',
            showImages: false,
            bundlePath: `${siteBase}/pagefind/`,
            baseUrl: `${siteBase}/`,
            resetStyles: false,
            translations: {
              placeholder: '搜索文档或关键字...',
              clear_search: '清空',
              load_more: '加载更多结果',
              search_label: '全站搜索',
              filters_label: '筛选',
              zero_results: '未找到关于 "[SEARCH_TERM]" 的相关内容',
              many_results: '找到 [COUNT] 条关于 "[SEARCH_TERM]" 的内容',
              one_result: '找到 1 条关于 "[SEARCH_TERM]" 的内容',
              alt_search: '未找到关于 "[SEARCH_TERM]" 的内容，改为显示 "[DIFFERENT_TERM]" 的结果',
              search_suggestion: '未找到关于 "[SEARCH_TERM]" 的内容，请尝试其他关键词',
              searching: '正在搜索 "[SEARCH_TERM]"...',
            },
          });
          const input = modal?.querySelector('input');
          if (input) input.focus();
        } catch (e) {
          console.warn('Pagefind init notice:', e);
        }
      };
      script.onerror = () => {
        pagefindInitializing = false;
        const container = document.getElementById('search-container');
        if (container) {
          container.innerHTML = `
            <div class="search-dev-hint">
              <p><strong>搜索索引尚未就绪</strong></p>
              <p>请在终端运行 <code>npm run build</code> 生成 Pagefind 索引文件。</p>
            </div>
          `;
        }
      };
      document.body.appendChild(script);
    }

    function openSearch() {
      if (!modal) return;
      modal.showModal();
      document.body.style.overflow = 'hidden';
      loadPagefindAssets();
      setTimeout(() => {
        const input = modal.querySelector('input');
        if (input) input.focus();
      }, 100);
    }

    function closeSearch() {
      if (!modal) return;
      modal.close();
      document.body.style.overflow = '';
    }

    trigger?.addEventListener('click', openSearch);
    closeBtn?.addEventListener('click', closeSearch);

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeSearch();
    });

    window.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (modal?.open) {
          closeSearch();
        } else {
          openSearch();
        }
      } else if (e.key === 'Escape' && modal?.open) {
        closeSearch();
      }
    });
  })();
</script>

<style>
  .search-wrapper {
    display: inline-flex;
    align-items: center;
  }

  .search-trigger-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 10px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: transparent;
    color: var(--muted);
    font-size: 13px;
    cursor: pointer;
    transition: border-color 160ms ease, color 160ms ease, background 160ms ease;
  }

  .search-trigger-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-soft);
  }

  .search-icon {
    width: 15px;
    height: 15px;
    stroke: currentColor;
  }

  .search-label {
    font-weight: 500;
  }

  .search-hotkey {
    font-family: var(--font-mono);
    font-size: 11px;
    padding: 1px 5px;
    border-radius: 4px;
    background: var(--paper-warm);
    border: 1px solid var(--line);
    color: var(--muted);
  }

  .search-modal {
    margin: auto;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.2);
    width: min(640px, calc(100% - 32px));
    max-height: 80vh;
  }

  .search-modal::backdrop {
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(2px);
  }

  .search-dialog-inner {
    display: flex;
    flex-direction: column;
    padding: 20px;
    max-height: 80vh;
    overflow-y: auto;
  }

  .search-dialog-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line);
  }

  .search-dialog-title {
    font-size: 14px;
    font-weight: 700;
    color: var(--ink);
    letter-spacing: 0.02em;
  }

  .search-close-btn {
    border: none;
    background: transparent;
    color: var(--muted);
    width: 28px;
    height: 28px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    border-radius: 4px;
  }

  .search-close-btn svg {
    width: 16px;
    height: 16px;
  }

  .search-close-btn:hover {
    color: var(--ink);
    background: var(--paper-warm);
  }

  .search-container {
    min-height: 120px;
  }

  .search-loading, .search-dev-hint {
    padding: 24px;
    text-align: center;
    color: var(--muted);
    font-size: 14px;
  }

  .search-dev-hint code {
    font-family: var(--font-mono);
    background: var(--paper-warm);
    padding: 2px 6px;
    border-radius: 4px;
  }

  @media (max-width: 640px) {
    .search-hotkey, .search-label {
      display: none;
    }
    .search-trigger-btn {
      padding: 7px;
    }
  }
</style>
