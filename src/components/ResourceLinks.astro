---
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { fileURLToPath } from 'node:url';
import { site } from '../lib/site';

interface Props {
  resources: Array<{ label: string; url: string }>;
}

const { resources } = Astro.props;
const siteBase = site.base.replace(/\/$/, '');
const publicDir = resolve(fileURLToPath(new URL('../../public/', import.meta.url)));
const codeExtensions = new Set(['.js', '.mjs', '.ts', '.tsx', '.jsx', '.py']);

function localCode(resource: { label: string; url: string }) {
  if (!resource.url.startsWith(`${siteBase}/`)) return null;

  try {
    const relativePath = decodeURIComponent(resource.url.slice(siteBase.length + 1));
    if (!relativePath || relativePath.split('/').includes('..')) return null;

    const filePath = resolve(publicDir, relativePath);
    const extension = filePath.slice(filePath.lastIndexOf('.'));
    if (!filePath.startsWith(`${publicDir}/`) || !codeExtensions.has(extension)) return null;

    return { ...resource, code: readFileSync(filePath, 'utf8') };
  } catch {
    return null;
  }
}
---

{resources.length > 0 && (
  <section class="resources">
    <h2>参考资源与示例代码</h2>
    <ul>
      {resources.map((resource) => {
        const codeResource = localCode(resource);
        return codeResource ? (
          <li class="resource-code">
            <details>
              <summary>{codeResource.label}</summary>
              <pre><code>{codeResource.code}</code></pre>
            </details>
          </li>
        ) : <li><a href={resource.url} target="_blank" rel="noopener">{resource.label} <span aria-hidden="true">↗</span></a></li>;
      })}
    </ul>
  </section>
)}
